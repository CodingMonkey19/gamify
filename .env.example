# API Keys and Environment Variables
# Copy this file to .env and fill in your values

# Notion Integration Token
NOTION_TOKEN=ntn_your_token_here

# Character
CHARACTER_ID=your_character_page_id_here

# Cloudinary (for avatar and radar chart images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI (for coaching and quest generation)
OPENAI_API_KEY=sk-proj-your_key_here

# --- Notion Database IDs ---

# Core
CHARACTER_DB_ID=f814ec57-8879-482b-81cb-e68104d252c8
DAILY_SNAPSHOTS_DB_ID=10168a1e-e30c-4907-8871-65519cec7abe

